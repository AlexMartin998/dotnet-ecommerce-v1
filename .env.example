# Copia a `.env` (gitignorado) y rellena. Lo usa docker-compose.prod.yml.
# Las variables sin valor por defecto ABORTAN el `up` si faltan: es deliberado.

# --- Obligatorias -------------------------------------------------------------
# 32+ caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
# La misma que MSSQL_SA_PASSWORD del compose central (000_infra).
MSSQL_SA_PASSWORD=

# --- Opcionales (valor por defecto entre paréntesis) --------------------------
# Nombre REAL de la red del compose central: `docker network ls | grep backend`
# INFRA_NETWORK=000_infra_backend
# API_PORT=8021
# SQL_DATABASE=ApiEcommerceNET8
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest
# JWT_ISSUER=ApiEcommerce
# JWT_AUDIENCE=ApiEcommerce.Client
# CORS_ORIGIN_0=http://localhost:3000
