{
  "//": "Config de DESARROLLO sin secretos. Los tres valores sensibles -cadena de conexion, clave JWT y password del admin sembrado- viven en user-secrets, fuera del repo. Puesta en marcha: ver README_init.md.",

  "Redis": {
    "Configuration": "172.17.0.1:6999",
    "InstanceName": "apiecommerce:",
    "DefaultTtlSeconds": 60
  },
  "Seed": {
    "//AdminPassword": "en user-secrets: dotnet user-secrets set \"Seed:AdminPassword\" \"...\"",
    "Enabled": true,
    "AdminUsername": "admin",
    "AdminEmail": "admin@apiecommerce.local"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "ApiEcommerce.Shared.Caching": "Debug"
      }
    }
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@172.17.0.1:5672",
    "Exchange": "apiecommerce.events",
    "Queue": "apiecommerce.product-purchased",
    "RoutingKey": "product.purchased",
    "PrefetchCount": 10
  },
  "Storage": {
    "ProductImagesFolder": "ProductsImages",
    "MaxBytes": 2097152
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  }
}
